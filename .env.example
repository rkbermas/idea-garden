# Supabase — from Project Settings → API.
# Leave both blank to run Idea Garden in browser-only demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables AI features (suggest connections, ask my library,
# contradictions, topic synthesis, search by meaning). Server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
